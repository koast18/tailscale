 import (
 	"net/netip"
+	"sync/atomic"
 
 	"tailscale.com/types/opt"
 )
@@ -15,12 +16,22 @@
 //
 // They're inlinable and the linker can deadcode that's guarded by them to make
 // smaller binaries.
+//
+// debugAlwaysDERP is the exception: it is a runtime flag set by cmd/tscore (the
+// iOS sideload dylib) via SetAlwaysDERP to force all peer traffic over DERP
+// (UDP sockets disabled).
+var alwaysDERP atomic.Bool
+
+// SetAlwaysDERP forces all peer traffic over DERP and disables UDP socket
+// binding (iOS/js build). Must be called before sockets are (re)bound.
+func SetAlwaysDERP(v bool) { alwaysDERP.Store(v) }
+
