diff --git a/wgengine/magicsock/debugknobs.go b/wgengine/magicsock/debugknobs.go
index 580d954c0..808a2256b 100644
--- a/wgengine/magicsock/debugknobs.go
+++ b/wgengine/magicsock/debugknobs.go
@@ -78,6 +78,18 @@
 // startup.
 func inTest() bool { return envknob.Bool("IN_TS_TEST") }
 
+// SetAlwaysDERP forces all peer communication over DERP (UDP disabled) at
+// runtime. On non-iOS platforms this routes through the
+// TS_DEBUG_ALWAYS_USE_DERP knob (kept in sync via envknob); cmd/tscore uses
+// the iOS-specific variant in debugknobs_stubs.go.
+func SetAlwaysDERP(v bool) {
+	if v {
+		envknob.Setenv("TS_DEBUG_ALWAYS_USE_DERP", "true")
+	} else {
+		envknob.Setenv("TS_DEBUG_ALWAYS_USE_DERP", "")
+	}
+}
+
 // pretendpoints returns TS_DEBUG_PRETENDPOINT as []AddrPort, if set.
