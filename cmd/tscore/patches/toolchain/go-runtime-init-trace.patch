diff --git a/src/runtime/tsinittrace.go b/src/runtime/tsinittrace.go
new file mode 100644
index 0000000..e0d7e3e
--- /dev/null
+++ b/src/runtime/tsinittrace.go
@@ -0,0 +1,62 @@
+//go:build darwin
+
+package runtime
+
+import "unsafe"
+
+// Startup trace for diagnosing dlopen hangs on iOS: the Go runtime of a
+// c-archive-based dylib initializes on a background thread spawned by the
+// constructor; when that thread stalls, every exported function blocks on
+// main_init_done. These helpers append "nanotime phase" lines to
+// /tmp/tscore-init.log (and, once env is available, to
+// <LC_HOME_PATH>/Documents/tscore-init.log) using raw syscalls, so they work
+// before the heap/threads exist. No allocation, no locking.
+var (
+	tsInitTraceTmpFD   int32 = -1
+	tsInitTraceDocFD   int32 = -1
+	tsInitTraceDocDone int32 = 0 // 0=untried 1=done(ok) 2=done(no env)
+)
+
+//go:noinline
+func tsInitTrace(phase string) {
+	writeTraceFD(&tsInitTraceTmpFD, "/tmp/tscore-init.log\x00", phase)
+	if tsInitTraceDocDone == 0 {
+		if home := gogetenv("LC_HOME_PATH"); home != "" {
+			var b [128]byte
+			n := copy(b[:], home)
+			n += copy(b[n:], "/Documents/tscore-init.log")
+			if n < len(b) {
+				b[n] = 0
+				tsInitTraceDocFD = open(&b[0], _O_WRONLY|_O_CREAT, 0o644)
+				tsInitTraceDocDone = 1
+			} else {
+				tsInitTraceDocDone = 2
+			}
+		} else {
+			tsInitTraceDocDone = 2
+		}
+	}
+	writeTraceFD(&tsInitTraceDocFD, "", phase)
+}
+
+//go:noinline
+func writeTraceFD(fd *int32, path, phase string) {
+	if *fd < 0 && path != "" {
+		*fd = open(&rawBytes(path)[0], _O_WRONLY|_O_CREAT, 0o644)
+	}
+	if *fd < 0 {
+		return
+	}
+	var b [128]byte
+	buf := itoa(b[:0], uint64(nanotime()))
+	buf = append(buf, ' ')
+	buf = append(buf, phase...)
+	buf = append(buf, '\n')
+	write1(uintptr(*fd), unsafe.Pointer(&buf[0]), int32(len(buf)))
+}
+
+// rawBytes exposes the data of a compile-time string constant (with its
+// trailing NUL) as a byte slice.
+func rawBytes(s string) []byte {
+	return unsafe.Slice(unsafe.StringData(s), len(s))
+}
